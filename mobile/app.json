{
  "expo": {
    "owner": "reddisekharmaruganis-organization",
    "name": "CampusRadius",
    "slug": "campusconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#eef3ff",
    "splash": {
      "backgroundColor": "#eef3ff",
      "resizeMode": "contain"
    },
