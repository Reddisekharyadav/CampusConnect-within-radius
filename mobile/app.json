      "**/*"
    ],
    "android": {
      "package": "com.campusradius.app",
      "adaptiveIcon": {
        "backgroundColor": "#eef3ff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusRadius uses your location only to show nearby users."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://10.74.178.134:5000",
      "eas": {
        "projectId": "4152238d-72c7-4777-b7f8-2070c654268f"
      }
    }
  }
}
