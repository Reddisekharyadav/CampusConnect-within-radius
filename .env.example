# Web (Vite): URL of deployed/local backend API
VITE_API_BASE_URL="http://localhost:5000"
VITE_GOOGLE_MAPS_API_KEY=""

# Backend: MongoDB Atlas connection string (M0 free tier, see DEPLOYMENT.md)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusradius"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# Backend: production hardening
# Comma-separated list of origins allowed to call the API, e.g.
# "https://your-frontend.pages.dev,chrome-extension://<extension-id>"
# Leave unset only for local development (defaults to "*"). In production
# the backend REFUSES to start if ALLOWED_ORIGINS is unset or contains "*".
ALLOWED_ORIGINS=""
# In production the backend refuses to start without MONGODB_URI unless
# this is explicitly set to "true" (in-memory preview mode, data is lost
# on restart). Never set this to "true" for a real release.
ALLOW_MEMORY_MODE=""
# Demo/seed users are NEVER seeded unless this is "1" (and, in
# production, ALLOW_DEMO_SEED_PRODUCTION="1" as well). Keep both unset
# for a real release.
ALLOW_DEMO_SEED=""
ALLOW_DEMO_SEED_PRODUCTION=""

# Auth: there is NO auth secret to set. Sessions are opaque random tokens
# (see backend/lib/auth.js); only their SHA-256 hash is stored, and
# passwords are stored only as scrypt hashes. Do not invent or commit a
# JWT secret — the design deliberately does not use JWTs.
